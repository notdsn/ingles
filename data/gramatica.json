    "porque": "Falta am/is/are."
   },
   {
    "errado": "She is going to studies.",
    "certo": "She is going to study.",
    "porque": "Depois de going to: verbo normal."
   },
   {
    "errado": "Do you going to travel?",
    "certo": "Are you going to travel?",
